<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KFRE Calculator & Clinical Record</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- FontAwesome for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- React & ReactDOM -->
  <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  
  <!-- Babel -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-slate-900 min-h-screen text-slate-800 font-sans relative overflow-x-hidden">
  <!-- Background Styling: ไล่สีน้ำเงินไปส้ม (Blue to Orange Gradient) -->
  <div class="fixed top-0 left-0 w-full h-full z-0 pointer-events-none" style="background: linear-gradient(135deg, #1e3a8a 0%, #f97316 100%);"></div>

  <div id="root" class="relative z-10 p-4 md:p-8"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    // --- Data & Helpers ---
    const medSuggestions = [
      "Amlodipine", "Atenolol", "Bisoprolol", "Carvedilol", "Clonidine", "Diltiazem", "Doxazosin", 
      "Enalapril", "Furosemide", "Hydralazine", "Hydrochlorothiazide (HCTZ)", "Losartan", "Manidipine", 
      "Methyldopa", "Metoprolol", "Nifedipine", "Prazosin", "Propranolol", "Spironolactone", 
      "Valsartan", "Verapamil", "Metformin", "Glipizide", "Gliclazide", "Pioglitazone", "Linagliptin", 
      "Sitagliptin", "Empagliflozin", "Dapagliflozin", "Atorvastatin", "Simvastatin", "Rosuvastatin",
      "Gemfibrozil", "Fenofibrate", "Aspirin", "Clopidogrel", "Warfarin", "Allopurinol", "Colchicine",
      "Febuxostat", "Calcium carbonate", "Sodium bicarbonate", "Folic acid", "Ferrous sulfate"
    ];

    const calculateKFRE = (age, gender, egfr, uacr) => {
        const a = parseFloat(age);
        const e = parseFloat(egfr);
        const u = parseFloat(uacr);
        if (isNaN(a) || isNaN(e) || isNaN(u) || e <= 0 || u <= 0) return null;

        const sex = gender === 'Male' ? 1 : 0;
        const termAge  = -0.2201 * ((a / 10) - 7.036);
        const termSex  = 0.2467 * (sex - 0.5642);
        const termEgfr = -0.5567 * ((e / 5) - 7.222);
        const termUacr = 0.4510 * (Math.log(u) - 5.137);

        const xBeta = termAge + termSex + termEgfr + termUacr;
        const s0_2year = 0.9832;
        const s0_5year = 0.9365;

        const risk2YrDecimal = 1 - Math.pow(s0_2year, Math.exp(xBeta));
        const risk5YrDecimal = 1 - Math.pow(s0_5year, Math.exp(xBeta));

        const risk2Year = Math.max(0, Math.min(100, risk2YrDecimal * 100));
        const risk5Year = Math.max(0, Math.min(100, risk5YrDecimal * 100));

        let recommendation = "";
        if (risk2Year > 40) {
            recommendation = "Begin KRT preparation and modality education";
        } else if (risk2Year > 10) {
            recommendation = "Initiate multidisciplinary care to delay CKD progression";
        }

        return { risk2: risk2Year.toFixed(2), risk5: risk5Year.toFixed(2), rec: recommendation };
    };

    // --- Components ---
    const AutocompleteInput = ({ value, onChange, onKeyDown, placeholder, className, suggestionsList, innerRef, ...props }) => {
      const [suggestion, setSuggestion] = useState('');
      useEffect(() => {
        if (!value || value.length < 2) { setSuggestion(''); return; }
        const match = suggestionsList.find(s => s.toLowerCase().startsWith(value.toLowerCase()));
        if (match) setSuggestion(value + match.substring(value.length));
        else setSuggestion('');
      }, [value, suggestionsList]);

      const handleKeyDown = (e) => {
        if ((e.key === 'Enter' || e.key === 'Tab' || e.key === 'ArrowRight') && suggestion && suggestion.toLowerCase() !== value.toLowerCase()) {
          e.preventDefault(); e.stopPropagation();
          onChange({ target: { value: suggestion, name: props.name } });
        } else { if (onKeyDown) onKeyDown(e); }
      };

      return (
        <div className={`relative flex flex-1`}>
          <input ref={innerRef} type="text" value={value} onChange={onChange} onKeyDown={handleKeyDown} placeholder={placeholder} className={`${className} w-full relative z-10 bg-white/70 backdrop-blur-sm border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg p-2.5 text-sm transition-all outline-none`} {...props} />
          {suggestion && suggestion.toLowerCase().startsWith(value.toLowerCase()) && (
            <div className={`absolute inset-0 pointer-events-none p-2.5 text-sm font-sans flex items-center overflow-hidden whitespace-pre z-20`}>
               <span className="text-transparent">{value}</span>
               <span className="text-slate-400 font-semibold">{suggestion.substring(value.length)}</span>
            </div>
          )}
        </div>
      );
    };

    const App = () => {
      const [formData, setFormData] = useState({
        name: '', age: '', gender: 'Male',
        bun: '', cr: '', gfr: '', 
        na: '', k: '', cl: '', hco3: '',
        uacr: '', upcr: '', hb: '', a1c: '',
        labOther: '',
        meds: []
      });

      const [newMed, setNewMed] = useState({ name: '', dose: '', freq: '' });
      const medNameRef = useRef(null);
      const medDoseRef = useRef(null);
      const medFreqRef = useRef(null);
      const [copied, setCopied] = useState(false);

      const handleChange = (e) => {
        const { name, value } = e.target;
        setFormData(prev => ({ ...prev, [name]: value }));
      };

      // Med Handlers
      const handleMedInputKeyDown = (e, nextRef, isLast) => {
        if (e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); if (isLast) addMed(); else if (nextRef && nextRef.current) nextRef.current.focus(); }
      };
      
      const addMed = () => {
        if (!newMed.name.trim()) { if (medNameRef.current) medNameRef.current.focus(); return; }
        setFormData(prev => ({ 
            ...prev, 
            meds: [...prev.meds, { id: Date.now(), ...newMed }] 
        }));
        setNewMed({ name: '', dose: '', freq: '' });
        if (medNameRef.current) medNameRef.current.focus();
      };
      
      const removeMed = (id) => {
          setFormData(prev => ({ ...prev, meds: prev.meds.filter(m => m.id !== id) }));
      };

      const kfre = calculateKFRE(formData.age, formData.gender, formData.gfr, formData.uacr);

      const summaryText = (() => {
          let parts = [];
          if (formData.name || formData.age) {
              let ptInfo = "Patient:";
              if (formData.name) ptInfo += ` ${formData.name}`;
              if (formData.age) ptInfo += ` (${formData.age} Yrs, ${formData.gender})`;
              else ptInfo += ` (${formData.gender})`;
              parts.push(ptInfo);
          }

          let labs = [];
          if (formData.bun) labs.push(`BUN ${formData.bun}`);
          if (formData.cr) labs.push(`Cr ${formData.cr}`);
          if (formData.gfr) labs.push(`eGFR ${formData.gfr}`);
          if (formData.na || formData.k || formData.cl || formData.hco3) {
              labs.push(`E-lyte: ${formData.na||'-'}/${formData.k||'-'}/${formData.cl||'-'}/${formData.hco3||'-'}`);
          }
          if (formData.hb) labs.push(`Hb ${formData.hb}`);
          if (formData.a1c) labs.push(`HbA1c ${formData.a1c}`);
          if (formData.uacr) labs.push(`UACR ${formData.uacr}`);
          if (formData.upcr) labs.push(`UPCR ${formData.upcr}`);
          
          let labsText = labs.join(', ');
          if (formData.labOther) {
              labsText = labsText ? `${labsText}\nOther Labs: ${formData.labOther}` : `Other Labs: ${formData.labOther}`;
          }
          if (labsText) parts.push(`[ Labs ]\n${labsText}`);

          if (kfre) {
              parts.push(`[ KFRE Risk (4-variable) ]\n2-Year Risk: ${kfre.risk2}%\n5-Year Risk: ${kfre.risk5}%\nRef: kidneyfailurerisk.com`);
          }

          if (formData.meds.length > 0) {
              let medsList = formData.meds.map((m, i) => `${i+1}. ${m.name} ${m.dose} ${m.freq}`.trim());
              parts.push(`[ Medications ]\n${medsList.join('\n')}`);
          }

          return parts.join('\n\n');
      })();

      const handleCopy = () => {
          try {
              // ใช้วิธี document.execCommand('copy') เพื่อให้ใช้ได้ทุกเบราว์เซอร์และ iframe
              const textArea = document.createElement("textarea");
              textArea.value = summaryText;
              
              // ซ่อน textarea ไม่ให้มองเห็น
              textArea.style.position = "fixed";
              textArea.style.left = "-999999px";
              textArea.style.top = "-999999px";
              document.body.appendChild(textArea);
              
              textArea.focus();
              textArea.select();
              document.execCommand('copy');
              
              textArea.remove();
              
              setCopied(true);
              setTimeout(() => setCopied(false), 2000);
          } catch (err) {
              console.error('Failed to copy text: ', err);
          }
      };

      return (
        <div className="max-w-4xl mx-auto space-y-6">
          
          {/* Header */}
          <div className="bg-white/10 backdrop-blur-md p-6 rounded-2xl shadow-lg border border-white/20 flex items-center gap-4">
             <div className="w-14 h-14 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center shadow-inner">
                <i className="fa-solid fa-calculator text-white text-2xl"></i>
             </div>
             <div>
                 <h1 className="text-2xl font-extrabold text-white tracking-wide">KFRE & Clinical Entry</h1>
                 <p className="text-blue-200 text-sm">Kidney Failure Risk Equation Calculator</p>
             </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-12 gap-6">
              
              {/* Left Column - Demo & Labs */}
              <div className="md:col-span-7 space-y-6">
                  
                  {/* Demographics (Required for KFRE) */}
                  <div className="bg-white/90 p-5 rounded-2xl shadow-md border border-slate-200">
                     <h2 className="text-sm font-bold text-slate-800 mb-4 border-b pb-2 flex items-center"><i className="fa-solid fa-user text-blue-600 mr-2"></i> Patient Demographics</h2>
                     <div className="mb-4">
                        <label className="block text-xs font-bold text-slate-500 mb-1">Name</label>
                        <input type="text" name="name" value={formData.name} onChange={handleChange} className="w-full rounded-lg p-2.5 text-sm bg-slate-50 border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Name (Optional)..." />
                     </div>
                     <div className="grid grid-cols-2 gap-4">
                        <div>
                            <label className="block text-xs font-bold text-blue-600 mb-1">Age (Years) *</label>
                            <input type="number" name="age" value={formData.age} onChange={handleChange} className="w-full rounded-lg p-2.5 text-sm bg-blue-50 border border-blue-200 focus:ring-2 focus:ring-blue-500 outline-none font-bold" placeholder="Req for KFRE" />
                        </div>
                        <div>
                            <label className="block text-xs font-bold text-blue-600 mb-1">Gender *</label>
                            <div className="flex bg-slate-100 rounded-lg p-1">
                                {['Male', 'Female'].map(g => (
                                    <button key={g} type="button" onClick={() => setFormData(prev => ({...prev, gender: g}))} 
                                    className={`flex-1 text-sm py-1.5 rounded-md font-bold transition-all ${formData.gender === g ? 'bg-blue-600 text-white shadow' : 'text-slate-500 hover:text-slate-700'}`}>
                                        {g}
                                    </button>
                                ))}
                            </div>
                        </div>
                     </div>
                  </div>

                  {/* Lab Results */}
                  <div className="bg-white/90 p-5 rounded-2xl shadow-md border border-slate-200">
                     <h2 className="text-sm font-bold text-slate-800 mb-4 border-b pb-2 flex items-center"><i className="fa-solid fa-flask text-blue-600 mr-2"></i> Laboratory</h2>
                     
                     {/* KFRE Required Labs */}
                     <div className="bg-blue-50/50 border border-blue-100 rounded-xl p-4 mb-5">
                         <div className="text-xs font-bold text-blue-800 mb-3 uppercase tracking-wider flex items-center"><i className="fa-solid fa-circle-exclamation mr-1.5"></i> Required for KFRE</div>
                         <div className="grid grid-cols-2 gap-4">
                            <div>
                                <label className="block text-xs font-bold text-blue-600 mb-1">eGFR (mL/min/1.73m²)</label>
                                <input type="number" step="any" name="gfr" value={formData.gfr} onChange={handleChange} className="w-full rounded-lg p-2.5 text-sm bg-white border border-blue-300 focus:ring-2 focus:ring-blue-500 outline-none font-bold text-blue-900" />
                            </div>
                            <div>
                                <label className="block text-xs font-bold text-blue-600 mb-1">UACR (mg/g)</label>
                                <input type="number" step="any" name="uacr" value={formData.uacr} onChange={handleChange} className="w-full rounded-lg p-2.5 text-sm bg-white border border-blue-300 focus:ring-2 focus:ring-blue-500 outline-none font-bold text-blue-900" />
                            </div>
                         </div>
                     </div>

                     {/* Other Basic Labs */}
                     <div className="grid grid-cols-2 gap-4 mb-4">
                         <div><label className="block text-xs font-bold text-slate-500 mb-1">BUN</label><input type="number" step="any" name="bun" value={formData.bun} onChange={handleChange} className="w-full rounded-lg p-2.5 text-sm bg-slate-50 border border-slate-300 outline-none" /></div>
                         <div><label className="block text-xs font-bold text-slate-500 mb-1">Creatinine</label><input type="number" step="any" name="cr" value={formData.cr} onChange={handleChange} className="w-full rounded-lg p-2.5 text-sm bg-slate-50 border border-slate-300 outline-none" /></div>
                     </div>
                     
                     <label className="block text-xs font-bold text-slate-500 mb-2 mt-4">Electrolytes</label>
                     <div className="grid grid-cols-4 gap-2 mb-4">
                         <input type="number" step="any" name="na" value={formData.na} onChange={handleChange} placeholder="Na" className="w-full rounded-lg p-2 text-sm text-center bg-slate-50 border border-slate-300 outline-none" />
                         <input type="number" step="any" name="k" value={formData.k} onChange={handleChange} placeholder="K" className="w-full rounded-lg p-2 text-sm text-center bg-slate-50 border border-slate-300 outline-none" />
                         <input type="number" step="any" name="cl" value={formData.cl} onChange={handleChange} placeholder="Cl" className="w-full rounded-lg p-2 text-sm text-center bg-slate-50 border border-slate-300 outline-none" />
                         <input type="number" step="any" name="hco3" value={formData.hco3} onChange={handleChange} placeholder="HCO3" className="w-full rounded-lg p-2 text-sm text-center bg-slate-50 border border-slate-300 outline-none" />
                     </div>

                     <div className="grid grid-cols-3 gap-3">
                         <div><label className="block text-xs font-bold text-slate-500 mb-1">Hb (g/dL)</label><input type="number" step="any" name="hb" value={formData.hb} onChange={handleChange} className="w-full rounded-lg p-2 text-sm bg-slate-50 border border-slate-300 outline-none" /></div>
                         <div><label className="block text-xs font-bold text-slate-500 mb-1">HbA1c (%)</label><input type="number" step="any" name="a1c" value={formData.a1c} onChange={handleChange} className="w-full rounded-lg p-2 text-sm bg-slate-50 border border-slate-300 outline-none" /></div>
                         <div><label className="block text-xs font-bold text-slate-500 mb-1">UPCR (g/g)</label><input type="number" step="any" name="upcr" value={formData.upcr} onChange={handleChange} className="w-full rounded-lg p-2 text-sm bg-slate-50 border border-slate-300 outline-none" /></div>
                     </div>

                     <div className="mt-4">
                         <label className="block text-xs font-bold text-slate-500 mb-1">Other Labs (ผลเลือดอื่นๆ)</label>
                         <textarea name="labOther" value={formData.labOther} onChange={handleChange} rows="2" placeholder="ระบุผลเลือดอื่นๆ..." className="w-full rounded-lg p-2.5 text-sm bg-slate-50 border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none resize-y custom-scrollbar"></textarea>
                     </div>
                  </div>
              </div>

              {/* Right Column - KFRE Display & Meds */}
              <div className="md:col-span-5 space-y-6">
                  
                  {/* KFRE Results Card */}
                  <div className="bg-gradient-to-br from-slate-800 to-slate-900 p-6 rounded-2xl shadow-xl border border-slate-700 relative overflow-hidden">
                      <div className="absolute top-0 right-0 w-32 h-32 bg-blue-500 rounded-full blur-3xl opacity-20 -mr-10 -mt-10"></div>
                      <h2 className="text-lg font-bold text-white mb-5 flex items-center relative z-10"><i className="fa-solid fa-chart-pie text-blue-400 mr-2"></i> KFRE Result</h2>
                      
                      {kfre ? (
                          <div className="space-y-4 relative z-10 animate-fade-in">
                              <div className="flex items-center justify-between bg-white/10 p-3 rounded-xl border border-white/10">
                                  <span className="text-sm font-semibold text-blue-200">2-Year Risk</span>
                                  <span className="text-2xl font-black text-white">{kfre.risk2}%</span>
                              </div>
                              <div className="flex items-center justify-between bg-white/10 p-3 rounded-xl border border-white/10">
                                  <span className="text-sm font-semibold text-blue-200">5-Year Risk</span>
                                  <span className="text-2xl font-black text-white">{kfre.risk5}%</span>
                              </div>
                              {kfre.rec && (
                                  <div className="bg-orange-500/20 border border-orange-500/30 p-3 rounded-xl mt-4">
                                      <span className="block text-xs font-bold text-orange-300 mb-1">Recommendation:</span>
                                      <p className="text-sm text-orange-100 leading-snug">{kfre.rec}</p>
                                  </div>
                              )}
                          </div>
                      ) : (
                          <div className="py-8 text-center relative z-10">
                              <div className="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-700 text-slate-500 mb-3"><i className="fa-solid fa-hourglass-empty text-xl"></i></div>
                              <p className="text-sm text-slate-400">Fill Age, Gender, eGFR, and UACR to calculate risk.</p>
                          </div>
                      )}
                  </div>

                  {/* Medications */}
                  <div className="bg-white/90 p-5 rounded-2xl shadow-md border border-slate-200">
                     <h2 className="text-sm font-bold text-slate-800 mb-4 border-b pb-2 flex items-center"><i className="fa-solid fa-pills text-blue-600 mr-2"></i> Medications</h2>
                     
                     <div className="space-y-2 mb-4 max-h-[250px] overflow-y-auto pr-1 custom-scrollbar">
                         {formData.meds.length === 0 ? (
                             <div className="text-center py-6 text-slate-400 text-sm italic bg-slate-50 rounded-lg border border-dashed border-slate-200">No medications added.</div>
                         ) : (
                             formData.meds.map((med, idx) => (
                                 <div key={med.id} className="flex items-center gap-2 bg-white border border-slate-200 p-2.5 rounded-xl shadow-sm group">
                                     <span className="text-xs font-bold text-slate-400 w-5">{idx + 1}.</span>
                                     <div className="flex-1 min-w-0">
                                         <div className="text-sm font-bold text-slate-800 truncate">{med.name}</div>
                                         <div className="text-xs text-slate-500">{med.dose} {med.freq}</div>
                                     </div>
                                     <button type="button" onClick={() => removeMed(med.id)} className="text-slate-300 hover:text-red-500 p-1.5 transition-colors"><i className="fa-solid fa-xmark"></i></button>
                                 </div>
                             ))
                         )}
                     </div>

                     <div className="pt-3 border-t border-slate-200">
                         <label className="block text-xs font-bold text-slate-500 mb-2">Add Medication</label>
                         <div className="flex flex-col gap-2">
                             <AutocompleteInput innerRef={medNameRef} value={newMed.name} onChange={e => setNewMed({...newMed, name: e.target.value})} onKeyDown={(e) => handleMedInputKeyDown(e, medDoseRef, false)} placeholder="Med name..." suggestionsList={medSuggestions} />
                             <div className="flex gap-2">
                                 <input ref={medDoseRef} type="text" value={newMed.dose} onChange={e => setNewMed({...newMed, dose: e.target.value})} onKeyDown={(e) => handleMedInputKeyDown(e, medFreqRef, false)} placeholder="Dose (e.g. 1 tab)" className="w-1/2 rounded-lg p-2.5 text-sm bg-white/70 border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none" />
                                 <input ref={medFreqRef} type="text" value={newMed.freq} onChange={e => setNewMed({...newMed, freq: e.target.value})} onKeyDown={(e) => handleMedInputKeyDown(e, medNameRef, true)} placeholder="Freq (e.g. pc)" className="w-1/2 rounded-lg p-2.5 text-sm bg-white/70 border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none" />
                             </div>
                             <button type="button" onClick={addMed} className="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-lg shadow-sm mt-1 transition-colors"><i className="fa-solid fa-plus mr-1"></i> Add Med</button>
                         </div>
                     </div>
                  </div>

              </div>
          </div>

          {/* Summary Note Section */}
          <div className="bg-white/90 p-6 rounded-2xl shadow-lg border border-slate-200 mt-6 mb-8 animate-fade-in">
             <div className="flex justify-between items-center mb-4 border-b pb-3">
                 <h2 className="text-lg font-bold text-slate-800 flex items-center"><i className="fa-solid fa-file-lines text-blue-600 mr-2"></i> Summary Note</h2>
                 <button type="button" onClick={handleCopy} className="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-2 px-5 rounded-xl shadow-md transition-all active:scale-95 flex items-center">
                     {copied ? <><i className="fa-solid fa-check mr-2"></i> Copied!</> : <><i className="fa-solid fa-copy mr-2"></i> Copy Note</>}
                 </button>
             </div>
             <textarea readOnly value={summaryText} className="w-full h-48 bg-slate-50/50 border border-slate-300 rounded-xl p-4 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y shadow-inner"></textarea>
          </div>
        </div>
      );
    };

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
